PORT=3000
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=your_secure_password

# MiniMax M2.5 (use OpenAI-compatible endpoint)
OPENAI_API_KEY=your_minimax_api_key
OPENAI_BASE_URL=https://api.minimax.io/v1

# Neon DB (for Nemu Catalog node)
NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Storage paths
DATABASE_PATH=/data/flowise
APIKEY_PATH=/data/flowise
SECRETKEY_PATH=/data/flowise
LOG_PATH=/data/logs
BLOB_STORAGE_PATH=/data/storage
